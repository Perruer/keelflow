{
    "name": "keelflow-monorepo",
    "version": "3.2.1",
    "private": true,
    "description": "Keelflow: build AI agents and LLM workflows visually. Security-maintained continuation of Flowise.",
    "homepage": "https://github.com/Perruer/keelflow",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Perruer/keelflow.git"
    },
    "bugs": {
        "url": "https://github.com/Perruer/keelflow/issues"
    },
    "workspaces": [
        "packages/*",
        "flowise",
        "ui",
        "components",
        "api-documentation"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:docker": "turbo run build",
        "build-force": "pnpm clean && turbo run build --force",
        "dev": "turbo run dev --parallel --no-cache",
        "start": "run-script-os",
        "start:windows": "cd packages/server/bin && run start",
        "start:default": "cd packages/server/bin && ./run start",
        "start-worker": "run-script-os",
        "start-worker:windows": "cd packages/server/bin && run worker",
        "start-worker:default": "cd packages/server/bin && ./run worker",
        "user": "run-script-os",
        "user:windows": "cd packages/server/bin && run user",
        "user:default": "cd packages/server/bin && ./run user",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "clean": "pnpm -r clean",
        "nuke": "pnpm -r nuke && rimraf node_modules .turbo",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "eslint \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "lint-fix": "pnpm lint --fix",
        "quick": "pretty-quick --staged",
        "postinstall": "husky install",
        "migration:create": "pnpm typeorm migration:create",
        "changeset": "changeset",
        "changeset:version": "changeset version"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md}": "eslint --fix"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.19.4",
        "@babel/preset-typescript": "7.18.6",
        "@changesets/cli": "^2.27.0",
        "@types/express": "^4.17.13",
        "@typescript-eslint/typescript-estree": "^7.13.1",
        "eslint": "^8.24.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-markdown": "^3.0.0",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-react": "^7.26.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-unused-imports": "^2.0.0",
        "husky": "^8.0.1",
        "kill-port": "2.0.1",
        "lint-staged": "^13.0.3",
        "prettier": "^2.7.1",
        "pretty-quick": "^3.1.3",
        "rimraf": "^3.0.2",
        "run-script-os": "^1.1.6",
        "turbo": "1.10.16",
        "typescript": "^5.4.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "faiss-node",
            "sqlite3"
        ],
        "overrides": {
            "adm-zip": "^0.6.1",
            "axios": "1.20.0",
            "@babel/plugin-transform-modules-systemjs": "^7.29.4",
            "basic-ftp": "^5.3.1",
            "body-parser": "2.0.2",
            "brace-expansion@1": "^1.1.18",
            "brace-expansion@2": "^2.1.4",
            "braces": "3.0.3",
            "browserslist": "^4.28.7",
            "convict": "^6.2.5",
            "cross-spawn": "7.0.6",
            "@elastic/transport": ">=8.9.3",
            "expr-eval": "npm:expr-eval-fork@^3.0.3",
            "fast-uri": "^3.1.6",
            "fast-xml-builder": "^1.1.7",
            "fast-xml-parser": "^5.7.0",
            "flatted": "^3.4.2",
            "form-data": "4.0.6",
            "glob-parent": "6.0.2",
            "glob@10": "^10.5.0",
            "@grpc/grpc-js": "^1.14.5",
            "handlebars": "^4.7.9",
            "hono": "^4.13.5",
            "http-proxy-middleware": "3.0.3",
            "immutable@4": "^4.3.9",
            "ip-address@10": "^10.3.1",
            "js-yaml@3": "^3.15.2",
            "js-yaml@4": "^4.3.2",
            "json5": "2.2.3",
            "jsonpath": "^1.3.0",
            "jws@3": "^3.2.3",
            "jws@4": "^4.0.1",
            "langchain@0.3": "^0.3.37",
            "langsmith": "^0.6.0",
            "launch-editor": "^2.14.1",
            "linkify-it": "^5.0.2",
            "lodash": "^4.18.1",
            "lodash-es": "^4.18.1",
            "minimatch@3": "^3.1.4",
            "@modelcontextprotocol/sdk": ">=1.25.2",
            "multer": "2.4.0",
            "mysql2": "^3.23.1",
            "nanoid@3": "^3.3.18",
            "node-forge": "^1.4.0",
            "nth-check": "2.1.1",
            "path-to-regexp": "0.1.13",
            "picomatch@2": "^2.3.2",
            "picomatch@3": "^3.0.2",
            "picomatch@4": "^4.0.4",
            "playwright": "^1.55.1",
            "playwright-core": "^1.55.1",
            "@playwright/test": "^1.55.1",
            "postcss@8": "^8.5.23",
            "prebuild-install": "7.1.3",
            "prismjs": "1.29.0",
            "protobufjs": ">=7.5.5",
            "request>uuid": "^3.4.0",
            "rollup": "4.63.4",
            "semver": "7.7.1",
            "set-value": "4.1.0",
            "sharp": "^0.35.4",
            "shell-quote": "^1.10.0",
            "solid-js": "1.9.11",
            "tar-fs": "3.1.1",
            "@tiptap/core": "^3.31.3",
            "tmp": ">=0.2.4",
            "@tootallnate/once": ">=3.0.1",
            "underscore": "^1.13.8",
            "undici@7": "^7.29.0",
            "unset-value": "2.0.1",
            "uuid": "^10.0.0",
            "validator": "^13.15.22",
            "webpack-dev-middleware": "7.4.2",
            "websocket-driver": "^0.7.5",
            "ws": "8.21.3",
            "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
            "@xmldom/xmldom": "^0.8.15"
        }
    },
    "engines": {
        "node": "^24",
        "pnpm": "^10.26.0"
    },
    "resolutions": {
        "@anthropic-ai/sdk": "^0.73.0",
        "@google/generative-ai": "^0.24.0",
        "@grpc/grpc-js": "^1.14.5",
        "@langchain/core": "1.1.20",
        "@qdrant/openapi-typescript-fetch": "1.2.6",
        "openai": "6.19.0",
        "protobufjs": "7.5.5",
        "uuid": "^10.0.0"
    },
    "eslintIgnore": [
        "**/dist",
        "**/node_modules",
        "**/build",
        "**/package-lock.json"
    ],
    "prettier": {
        "printWidth": 140,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "endOfLine": "auto"
    },
    "babel": {
        "presets": [
            "@babel/preset-typescript",
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    }
}
